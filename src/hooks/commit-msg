#!/bin/sh
# Compatibility dispatcher. Install post-commit alongside this hook for logging.
# Run captains-log setup after upgrading to replace the legacy commit-msg logger.
HOOKS_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$HOOKS_DIR/commit-msg-precommit" ]; then
    exec "$HOOKS_DIR/commit-msg-precommit" "$@"
fi
exit 0
